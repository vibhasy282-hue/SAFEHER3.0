# SafeHer Production Environment Variables
# Copy this file to .env and update with your actual values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-domain.com

# ===========================================
# MONGODB DATABASE
# ===========================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=your_secure_mongo_password
MONGODB_URI=mongodb://admin:your_secure_mongo_password@mongodb:27017/safeher?authSource=admin

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your_super_secure_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_minimum_32_characters

# ===========================================
# CLOUDINARY (MEDIA STORAGE)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===========================================
# EMAIL SERVICE (GMAIL)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# ===========================================
# SMS SERVICE (TWILIO)
# ===========================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# GOOGLE MAPS API
# ===========================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=https://your-domain.com/api
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ===========================================
# SECURITY & ENCRYPTION
# ===========================================
ENCRYPTION_KEY=your_32_character_encryption_key_here

# ===========================================
# ADMINISTRATION
# ===========================================
ADMIN_EMAIL=admin@your-domain.com

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=info
ENABLE_METRICS=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
EMERGENCY_RATE_LIMIT_MAX_REQUESTS=10

# ===========================================
# FILE UPLOAD LIMITS
# ===========================================
MAX_FILE_SIZE=50MB
MAX_VIDEO_DURATION=300

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_SECRET=your_session_secret_key_minimum_32_characters
SESSION_TIMEOUT=3600000

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ===========================================
# SSL CERTIFICATE PATHS
# ===========================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
